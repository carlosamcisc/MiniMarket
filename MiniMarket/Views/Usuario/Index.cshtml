@model List<MiniMarket.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-white bg-opacity-25 p-2 me-3">
                                <i class="bi bi-people-fill fs-4 text-white"></i>
                            </div>
                            <div>
                                <h4 class="mb-0 fw-bold text-white">Lista de Usuarios</h4>
                                <p class="mb-0 text-white opacity-75 small">Administra las cuentas de vendedores y gerentes</p>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Create" class="btn btn-light btn-lg rounded-pill shadow-sm">
                                <i class="bi bi-person-plus-fill"></i> Nuevo Usuario
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Cuerpo -->
                <div class="card-body p-0">

                    <!-- Tabla -->
                    <div class="table-responsive">
                        @if (!Model.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                                <h5 class="text-muted">No se encontraron usuarios</h5>
                                <a asp-action="Create" class="btn btn-primary mt-3">Agregar primer usuario</a>
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover align-middle mb-0" id="usuariosTable">
                                <thead>
                                    <tr class="text-center">
                                        <th style="background-color: #667eea">#</th>
                                        <th style="background-color: #667eea">Nombre</th>
                                        <th style="background-color: #667eea">Correo</th>
                                        <th style="background-color: #667eea">Rol</th>
                                        <th style="background-color: #667eea">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int contador = 1;
                                    }
                                    @foreach (var usuario in Model)
                                    {
                                        <tr>
                                            <td class="text-center">@contador</td>
                                            <td>@usuario.Nombre</td>
                                            <td>@usuario.Correo</td>
                                            <td class="text-center">
                                                <span class="badge rounded-pill text-bg-secondary">@(usuario.Rol?.Nombre ?? "Sin rol")</span>
                                            </td>
                                            <td class="text-center">
                                                <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-info btn-sm text-white">Ver</a>
                                                @if (usuario.Rol?.Nombre != "Administrador")
                                                {
                                                    <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-warning btn-sm">Editar</a>
                                                    <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-danger btn-sm">Eliminar</a>
                                                }
                                            </td>
                                        </tr>
                                        contador++;
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    @if (Model.Any())
                    {
                        <div class="p-3 bg-light border-top text-end">
                            <small class="text-muted">Total: @Model.Count() usuarios</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table th {
        background-color: #212529;
        color: white;
        padding: 12px;
    }

    .table td {
        padding: 12px;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.05);
    }

    .btn-sm {
        margin: 0 2px;
    }

    @@media (max-width: 768px) {
        .btn-sm {
            margin: 2px;
        }

        .table td, .table th {
            padding: 8px;
            font-size: 0.85rem;
        }
    }
</style>
