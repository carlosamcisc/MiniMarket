@model List<MiniMarket.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-people-fill"></i> Usuarios</h2>
            <p class="text-muted mb-0">Administra las cuentas de vendedores y gerentes</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Nuevo usuario
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.Nombre</td>
                            <td>@usuario.Correo</td>
                            <td>
                                <span class="badge rounded-pill text-bg-secondary">@(usuario.Rol?.Nombre ?? "Sin rol")</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="Ver">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (usuario.Rol?.Nombre != "Administrador")
                                {
                                    <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary rounded-3 ms-1" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-danger rounded-3 ms-1" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
